<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PomodoroTimer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="640"
            Padding="24,16,24,24"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Timer" />
            <NumberBox
                Width="240"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="WorkMinutesNumberBox"
                Header="Work duration (minutes)"
                LargeChange="5"
                Maximum="120"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValidationMode="InvalidInputOverwritten"
                Value="{x:Bind Vm.WorkMinutes, Mode=TwoWay}" />
            <NumberBox
                Width="240"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="BreakMinutesNumberBox"
                Header="Break duration (minutes)"
                LargeChange="5"
                Maximum="120"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValidationMode="InvalidInputOverwritten"
                Value="{x:Bind Vm.BreakMinutes, Mode=TwoWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Durations can be 1 to 120 minutes. If a countdown is in progress, the new durations apply at the next phase or when you reset the timer."
                TextWrapping="Wrap" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Appearance" />
            <!--  Item order must match the AppTheme enum values (Light = 0, Dark = 1, System = 2).  -->
            <RadioButtons
                AutomationProperties.AutomationId="ThemeRadioButtons"
                Header="Theme"
                SelectedIndex="{x:Bind Vm.SelectedThemeIndex, Mode=TwoWay}">
                <RadioButton AutomationProperties.AutomationId="ThemeLightRadioButton" Content="Light" />
                <RadioButton AutomationProperties.AutomationId="ThemeDarkRadioButton" Content="Dark" />
                <RadioButton AutomationProperties.AutomationId="ThemeSystemRadioButton" Content="Use system setting" />
            </RadioButtons>
        </StackPanel>
    </ScrollViewer>
</Page>
