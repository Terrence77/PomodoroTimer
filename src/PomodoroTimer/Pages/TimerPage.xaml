<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PomodoroTimer.Pages.TimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PomodoroTimer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Timer" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">

            <!--  Phase badge: accent for Work, success tone for Break. Both use theme brushes.  -->
            <Grid HorizontalAlignment="Center">
                <Border
                    Padding="20,4"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="16"
                    Visibility="{x:Bind local:TimerPage.VisibleWhen(Vm.IsWorkPhase), Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="WorkPhaseText"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Vm.PhaseLabel, Mode=OneWay}" />
                </Border>
                <Border
                    Padding="20,4"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                    BorderThickness="2"
                    CornerRadius="16"
                    Visibility="{x:Bind local:TimerPage.CollapsedWhen(Vm.IsWorkPhase), Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="BreakPhaseText"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Vm.PhaseLabel, Mode=OneWay}" />
                </Border>
            </Grid>

            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="RemainingTimeText"
                FontSize="112"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{StaticResource DisplayTextBlockStyle}"
                Text="{x:Bind Vm.RemainingText, Mode=OneWay}" />

            <ProgressBar
                Width="320"
                AutomationProperties.AutomationId="PhaseProgressBar"
                AutomationProperties.Name="Phase progress"
                Maximum="100"
                Value="{x:Bind Vm.Progress, Mode=OneWay}" />

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="112"
                    x:Name="StartButton"
                    AutomationProperties.AutomationId="StartButton"
                    AutomationProperties.Name="Start"
                    Click="StartButton_Click"
                    Command="{x:Bind Vm.StartCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button
                    MinWidth="112"
                    x:Name="PauseButton"
                    AutomationProperties.AutomationId="PauseButton"
                    AutomationProperties.Name="Pause"
                    Click="PauseButton_Click"
                    Command="{x:Bind Vm.PauseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Pause" />
                        <TextBlock Text="Pause" />
                    </StackPanel>
                </Button>
                <Button
                    MinWidth="112"
                    AutomationProperties.AutomationId="ResetButton"
                    AutomationProperties.Name="Reset"
                    Command="{x:Bind Vm.ResetCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Reset" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
